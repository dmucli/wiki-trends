---
import type { EditionEntry } from "../../../types/article.ts";
import { articleHref, formatViews, t, type Lang } from "../lib/content.ts";
import Sparkline from "./Sparkline.astro";
interface Props { entries: EditionEntry[]; date: string; lang: Lang }
const { entries, date, lang } = Astro.props;
const s = t(lang);
---
<section class="most-read" aria-labelledby="most-read-title">
  <h2 class="section-title" id="most-read-title">{s.mostRead}</h2>
  <ol>
    {entries.map((e) => (
      <li class={`cat-${e.category}`}>
        <span class="n">{e.rank}</span>
        <div>
          <a href={articleHref({ date, slug: e.slug }, lang)}>{e.title}</a>
          <span class="meta">{formatViews(lang, e.views)} {s.views}</span>
        </div>
        <Sparkline series={e.series} width={64} height={22} label={s.last30} />
      </li>
    ))}
  </ol>
</section>
<style>
  ol { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 64px; gap: .6rem; align-items: center; padding: .55rem 0; border-bottom: 1px solid var(--line); }
  .n { font-family: var(--display); font-weight: 800; font-size: 1.35rem; color: var(--c); font-variant-numeric: tabular-nums; letter-spacing: -.03em; }
  a { font-family: var(--display); font-weight: 600; font-size: .95rem; line-height: 1.2; text-decoration: none; display: block; }
  a:hover { text-decoration: underline; }
  .meta { font-size: .75rem; }
</style>
