---
import Base from "../layouts/Base.astro";
import StoryCard from "./StoryCard.astro";
import MostRead from "./MostRead.astro";
import { article, edition, editionDates, editionHref, formatDate, t, type Lang } from "../lib/content.ts";

interface Props { lang: Lang; date: string; isFront?: boolean }
const { lang, date, isFront = false } = Astro.props;
const s = t(lang);
const ed = edition(lang, date);
const [lead, ...rest] = ed.entries;
const secondary = rest.slice(0, 2);
const grid = rest.slice(2, 11);
const more = rest.slice(11);
const dates = editionDates(lang);
const i = dates.indexOf(date);
const older = dates[i + 1];
const newer = dates[i - 1];
const other: Lang = lang === "en" ? "fr" : "en";
const altHref = editionDates(other).includes(date) ? (isFront ? `/${other}/` : editionHref(other, date)) : `/${other}/`;
---
<Base lang={lang} editionDate={date} altHref={altHref}
  title={isFront ? undefined : `${s.edition} ${formatDate(lang, date)}`}
  description={lead ? lead.headline : undefined} image={lead?.image?.url}>
  <p class="edition-line meta">
    {s.edition} {formatDate(lang, date)}
    {older && <> · <a href={editionHref(lang, older)}>← {formatDate(lang, older, { day: "numeric", month: "short" })}</a></>}
    {newer && <> · <a href={editionHref(lang, newer)}>{formatDate(lang, newer, { day: "numeric", month: "short" })} →</a></>}
  </p>

  {lead && (
    <section class="top">
      <div class="lead"><StoryCard entry={lead} date={date} lang={lang} variant="lead" whyNow={article(lang, date, lead.slug).whyNow} /></div>
      <div class="secondary">
        {secondary.map((e) => <StoryCard entry={e} date={date} lang={lang} />)}
      </div>
    </section>
  )}

  <div class="columns">
    <div class="main">
      <div class="grid">
        {grid.map((e) => <StoryCard entry={e} date={date} lang={lang} />)}
      </div>
      {more.length > 0 && (
        <section class="more">
          <h2 class="section-title">{s.relatedToday}</h2>
          <div class="more-grid">
            {more.map((e) => <StoryCard entry={e} date={date} lang={lang} variant="compact" />)}
          </div>
        </section>
      )}
    </div>
    <aside class="aside"><MostRead entries={ed.entries} date={date} lang={lang} /></aside>
  </div>
</Base>

<style>
  .edition-line { margin: 0 0 1.25rem; }
  .edition-line a { color: inherit; }
  .top { display: grid; gap: 1.75rem; padding-bottom: 2rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
  .secondary { display: grid; gap: 1.75rem; }
  @media (min-width: 900px) {
    .top { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
    .secondary { border-left: 1px solid var(--line); padding-left: 1.75rem; }
  }
  .columns { display: grid; gap: 2.5rem; }
  .top > *, .columns > *, .secondary > * { min-width: 0; }
  @media (min-width: 1000px) { .columns { grid-template-columns: minmax(0, 1fr) 20rem; } .aside { border-left: 1px solid var(--line); padding-left: 1.75rem; } }
  .grid { display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
  .more { margin-top: 3rem; }
  .more-grid { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 11rem), 1fr)); }
</style>
